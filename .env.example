# Copy to .env.local for local dev. Never commit real values.
# On Vercel: MONGODB_URI is added automatically by the MongoDB Atlas integration;
# add the rest yourself in Project Settings → Environment Variables.

# --- Required -------------------------------------------------------------
# MongoDB connection string (Atlas: mongodb+srv://..., local: mongodb://127.0.0.1:27017)
MONGODB_URI=
MONGODB_DB=nihongoacademy

# Random string, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Public https URL of the site (used in Telegram links). Local: http://localhost:4028
NEXT_PUBLIC_SITE_URL=http://localhost:4028

# --- AI tutor, explain-mistake, interview roleplay (optional) --------------
# Without any key the AI features run in DEMO mode (canned answers, clearly labelled).
# Set AI_DEMO=off to hide AI features instead.
#
# FREE, works from Myanmar — OpenRouter (https://openrouter.ai/keys, no credit card).
# "openrouter/free" picks a free model automatically; or use any model id ending in ":free".
OPENROUTER_API_KEY=
# Comma-separated, tried in order (default: Gemma 4 31B → Gemma 4 26B → openrouter/free)
OPENROUTER_MODEL=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,openrouter/free
# FREE alternative — Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Any other OpenAI-compatible service
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
# Gemini free tier (not available in every country)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# PAID: Claude. Used when AI_PROVIDER=anthropic, or when it is the only key.
ANTHROPIC_API_KEY=
# Force one provider: anthropic | gemini | demo
AI_PROVIDER=
AI_MODEL=claude-opus-5-5
AI_DEMO=

# Daily AI uses per learner (keeps you inside the free tier's daily request limit)
AI_FREE_DAILY_LIMIT=5
AI_PAID_DAILY_LIMIT=200

# --- Telegram reminders (optional) ----------------------------------------
# Create a bot with @BotFather, then run: npm run telegram:setup -- .env.production.local
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Any random string; Telegram sends it back so we know webhook calls are genuine
TELEGRAM_WEBHOOK_SECRET=
# Vercel Cron sends this as a Bearer token to /api/cron/daily
CRON_SECRET=
