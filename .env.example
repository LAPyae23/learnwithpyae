# Copy to .env.local for local dev. Never commit real values.
# On Vercel: MONGODB_URI is added automatically by the MongoDB Atlas integration;
# add the rest yourself in Project Settings → Environment Variables.

# --- Required -------------------------------------------------------------
# MongoDB connection string (Atlas: mongodb+srv://..., local: mongodb://127.0.0.1:27017)
MONGODB_URI=
MONGODB_DB=nihongoacademy

# Random string, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Public https URL of the site (used in Telegram links). Local: http://localhost:4028
NEXT_PUBLIC_SITE_URL=http://localhost:4028

# --- AI tutor, explain-mistake, interview roleplay (optional) --------------
# FREE: get a Gemini API key at https://aistudio.google.com/apikey (no credit card).
# Free tier note: Google may use free-tier prompts/answers to improve its products.
GEMINI_API_KEY=
# Free-tier models. The fallback is used automatically when the main one is rate-limited.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# PAID alternative (optional): Claude. Used if there's no Gemini key, or when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
AI_PROVIDER=
AI_MODEL=claude-opus-5-5

# Daily AI uses per learner (keeps you inside the free tier's daily request limit)
AI_FREE_DAILY_LIMIT=5
AI_PAID_DAILY_LIMIT=200

# --- Telegram reminders (optional) ----------------------------------------
# Create a bot with @BotFather, then run: npm run telegram:setup -- .env.production.local
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Any random string; Telegram sends it back so we know webhook calls are genuine
TELEGRAM_WEBHOOK_SECRET=
# Vercel Cron sends this as a Bearer token to /api/cron/daily
CRON_SECRET=
